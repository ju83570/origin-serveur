diff --git a/hostinger/vivant/api/payment-policy.php b/hostinger/vivant/api/payment-policy.php
new file mode 100644
index 0000000..a54bf17
--- /dev/null
+++ b/hostinger/vivant/api/payment-policy.php
@@ -0,0 +1,26 @@
+<?php
+declare(strict_types=1);
+
+// Fonctions pures : testables sans Stripe, compte client ou identifiants réels.
+function paymentPolicy(array $config): array {
+    $mode = (string)($config['mode'] ?? 'staging');
+    $secret = (string)($config['stripe_secret'] ?? '');
+    $test = $mode === 'test';
+    $enabled = $test
+        ? ($config['test_payments_enabled'] ?? false) === true && str_starts_with($secret, 'sk_test_')
+        : $mode === 'production'
+          && ($config['live_payments_approved'] ?? false) === true
+          && ($config['legal_approved'] ?? false) === true
+          && ($config['payments_enabled'] ?? false) === true
+          && str_starts_with($secret, 'sk_live_');
+    return ['enabled'=>$enabled, 'test'=>$test, 'mode'=>$mode];
+}
+
+function stripeKeyAllowed(array $config): bool {
+    $mode = (string)($config['mode'] ?? 'staging');
+    $secret = (string)($config['stripe_secret'] ?? '');
+    if (in_array($mode, ['staging', 'test'], true)) return str_starts_with($secret, 'sk_test_');
+    return $mode === 'production'
+        && ($config['live_payments_approved'] ?? false) === true
+        && str_starts_with($secret, 'sk_live_');
+}
diff --git a/hostinger/vivant/api/schema.sql b/hostinger/vivant/api/schema.sql
new file mode 100644
index 0000000..e8049da
--- /dev/null
+++ b/hostinger/vivant/api/schema.sql
@@ -0,0 +1,62 @@
+-- Execute with phpMyAdmin on a NEW dedicated MySQL database (utf8mb4).
+CREATE TABLE IF NOT EXISTS users (
+ id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+ email VARCHAR(190) NOT NULL UNIQUE,
+ password_hash VARCHAR(255) NOT NULL,
+ session_version BIGINT UNSIGNED NOT NULL DEFAULT 1,
+ verified_at DATETIME NULL,
+ stripe_customer_id VARCHAR(100) UNIQUE NULL,
+ privacy_version VARCHAR(30) NOT NULL,
+ privacy_accepted_at DATETIME NOT NULL,
+ created_at DATETIME NOT NULL
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS email_tokens (
+ user_id BIGINT UNSIGNED PRIMARY KEY,
+ token_hash CHAR(64) NOT NULL UNIQUE,
+ expires_at DATETIME NOT NULL,
+ FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+-- A distinct one-time token, not the password, is emailed for password recovery.
+CREATE TABLE IF NOT EXISTS password_resets (
+ user_id BIGINT UNSIGNED PRIMARY KEY,
+ token_hash CHAR(64) NOT NULL UNIQUE,
+ expires_at DATETIME NOT NULL,
+ FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS user_state (
+ user_id BIGINT UNSIGNED PRIMARY KEY,
+ sealed_payload MEDIUMTEXT NOT NULL,
+ updated_at DATETIME NOT NULL,
+ FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS subscriptions (
+ id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+ user_id BIGINT UNSIGNED NOT NULL,
+ stripe_subscription_id VARCHAR(100) NOT NULL UNIQUE,
+ plan VARCHAR(40) NOT NULL,
+ status VARCHAR(40) NOT NULL,
+ current_period_end DATETIME NULL,
+ updated_at DATETIME NOT NULL,
+ FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
+ INDEX idx_user (user_id)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS purchases (
+ id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+ user_id BIGINT UNSIGNED NOT NULL,
+ stripe_session_id VARCHAR(120) NOT NULL UNIQUE,
+ status VARCHAR(20) NOT NULL,
+ created_at DATETIME NOT NULL,
+ FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS stripe_events (
+ event_id VARCHAR(150) PRIMARY KEY,
+ event_type VARCHAR(100) NOT NULL,
+ processed_at DATETIME NOT NULL
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS rate_limits (
+ id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+ bucket VARCHAR(25) NOT NULL,
+ fingerprint CHAR(64) NOT NULL,
+ created_at DATETIME NOT NULL,
+ INDEX idx_limits (bucket, fingerprint, created_at)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
